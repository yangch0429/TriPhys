# Copy to .env, fill in, then `set -a; source .env; set +a`. Never commit the filled file.

# ---- videos (not redistributed; see README "Videos") ----
EGOEXO_ROOT=/path/to/egoexo4d/takes          # MPR: <EGOEXO_ROOT>/<take_uid>/best_exo.mp4
BAAI_ROOT=/path/to/BAAI-Physics-aware-videos   # KPR: <BAAI_ROOT>/<folder_id>/<video_id>.mp4
# TRIPHYS_DATA_DIR=./data

# ---- GPT-5.5 / Gemini-3.6-Flash: any OpenAI-compatible endpoint ----
CHAT_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=          # also used by the ACC judge
# model ids as named by the endpoint
GPT_MODEL=openai/gpt-5.5
GEMINI_MODEL=google/gemini-3.6-flash

# ---- ACC judge (gpt-4o-mini; nonconforming responses and TYPE_D) ----
ACC_JUDGE_BASE=https://openrouter.ai/api/v1
ACC_JUDGE_MODEL=openai/gpt-4o-mini
ACC_JUDGE_API_KEY=            # falls back to OPENROUTER_API_KEY

# ---- SCS judge (DeepSeek-V4-Flash) ----
SCS_JUDGE_BASE=https://api.deepseek.com
SCS_JUDGE_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# ---- web_search tool (Serper / Google); comma-separated, rotated when a key is rate-limited or out of credit ----
SERPER_API_KEYS=

# ---- optional ----
# FFMPEG=/path/to/ffmpeg      # Gemini clip re-encoding; default: imageio-ffmpeg, then ffmpeg on PATH

# ---- benchmark construction (construction/README.md) ----
# VLM_API_KEY=                                 # Gemini key if CHAT_API_BASE is not OpenRouter
# DEEPSEEK_BASE=https://openrouter.ai/api/v1   # LLM endpoint for construction (data were generated via OpenRouter)
# DEEPSEEK_MODEL=deepseek/deepseek-v3.2
# JINA_API_KEY=                                # page_browser tool
# QWEN_BASE_URL=http://localhost:8089/v1       # visual_question_answering tool (self-hosted Qwen3-Omni)
# QWEN_MODEL=qwen3-omni-30b-a3b-thinking
# EGOEXO_RAW_ROOT=/path/to/EgoExo4D             # raw download (selection / packing only)
# EGOEXO_SELECTION=selected_egoexo200.json
# EGOEXO_SELECTED_ROOT=/path/to/egoexo4d_selected   # manifest.json, takes/, annotations/ (EGOEXO_ROOT = this/takes)
# MPR_OUTPUT_DIR=A_class_Benchmark/output
# MPR_QA_DATASET=A_class_Benchmark/aclass_qa_dataset.json
# BAAI_SELECTION=baai_selected_160.json
# KPR_OUTPUT_DIR=B_class_Benchmark/outputs
# SHARED_LIBRARY=A_class_Benchmark/output/_shared_physics_library.json
